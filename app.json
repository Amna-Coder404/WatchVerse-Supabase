{
  "expo": {
    "name": "WatchVerse",
    "slug": "watchverse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "watchverse",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.devamna.WatchVerse",
      "adaptiveIcon": {
        "backgroundColor": "#0F0F12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0F12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "expo-video",
      "expo-image"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "35736f10-131d-44a9-9974-48b2a000fb5a"
      }
    },
    "owner": "mobile-dev-pro"
  }
}
